# Use NEW API key slots, distinct from the running margin guard's keys.
# Never use wallet seed phrases or L1 wallet private keys here.
RH_ACCOUNT_INDEX=
RH_HEDGE_API_KEY_INDEX=5
RH_HEDGE_API_PRIVATE_KEY=
CORE_ACCOUNT_INDEX=
CORE_HEDGE_API_KEY_INDEX=4
CORE_HEDGE_API_PRIVATE_KEY=

# Add this variable to the EXISTING margin guard's environment as well.
AUTO_HEDGE_STATE_DIR=/var/lib/auto-hedge
